{
  "name": "dsh-im-bridge",
  "version": "0.76.0",
  "description": "QQ (NapCat / OneBot 11) ↔ DeepSeek Harness bridge: chat with your harness from QQ, with a full management panel",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "qq",
    "napcat",
    "onebot",
    "chatbot"
  ],
  "license": "MIT",
  "author": "cheems135",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheems135/dsh-qq-bridge.git"
  },
  "homepage": "https://github.com/cheems135/dsh-qq-bridge#readme",
  "bugs": {
    "url": "https://github.com/cheems135/dsh-qq-bridge/issues"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "console.html",
    "cordis.patch.yml",
    "assets/**",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
